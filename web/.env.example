# Supabase project URL + anon (public) key — Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# true = route all Supabase traffic through this app's own domain (/sb/*)
# (protects against ISP blocking of *.supabase.co). Requires the rewrite in vercel.json / netlify.toml
VITE_USE_PROXY=false

# Synthetic email domain used to map mobile/username logins to Supabase Auth
VITE_LOGIN_DOMAIN=login.riospinwin.app
